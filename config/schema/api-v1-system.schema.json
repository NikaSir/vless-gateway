{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_version",
    "generated_at",
    "state",
    "freshness",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "gateway_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "healthy",
        "starting",
        "degraded_fail_open",
        "control_error"
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "age_seconds",
        "stale"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "age_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "uptime",
        "temperature",
        "load",
        "storage_free",
        "sing_box_version"
      ],
      "properties": {
        "uptime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "temperature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "storage_free": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "sing_box_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "available": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "error": {
      "type": "string"
    }
  }
}
