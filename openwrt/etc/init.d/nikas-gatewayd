#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043
USE_PROCD=1
START=96
STOP=9
start_service() {
 procd_open_instance
 procd_set_param command /usr/bin/gatewayd --config-root /etc/nikas-vless
 procd_set_param respawn 3600 5 0
 procd_set_param file /etc/nikas-vless/settings.json /etc/nikas-vless/hardware.json /etc/nikas-vless/auth.json
 procd_set_param netdev "$(uci -q get network.nikas_mgmt.device)"
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger nikas-vless network; }
