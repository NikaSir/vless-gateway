#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043
USE_PROCD=1
START=95
STOP=10
start_service() {
 [ "$(uci -q get nikas-vless.main.policy_enabled)" = 1 ] || return 0
 if [ "${NIKAS_CONFIG_ACTIVATION:-0}" != 1 ]; then
  gatewayctl --config-root /etc/nikas-vless recover-config || return 1
  gatewayctl --config-root /etc/nikas-vless recover-rules || return 1
 fi
 sing-box check -c /etc/nikas-vless/config.json >/dev/null 2>&1 || return 1
 procd_open_instance
 procd_set_param command /usr/libexec/nikas-sing-box-run
 procd_set_param respawn 3600 5 0
 procd_set_param file /etc/nikas-vless/config.json /etc/nikas-vless/auth.json
 procd_set_param netdev "$(uci -q get network.nikas_up.device)" "$(uci -q get network.nikas_down.device)"
 procd_set_param term_timeout 10
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
stop_service() {
 /usr/libexec/nikas-interception-cleanup
}
reload_service() { stop; start; }
service_triggers() {
 procd_add_reload_trigger nikas-vless network firewall
}
